  "cards": [
    {
      "dot": "emerald",
      "title": "Architectural Core",
      "items": [
        "Per-Layer Embeddings (PLE) blend identity table and projected embeddings",
        "20 decoder blocks split at boundary 10 into 10 producers and 10 consumers",
        "Shared suffix layers alias prefix K/V states and double MLP intermediate width"
      ]
    },
    {
      "dot": "cyan",
      "title": "Attention Hierarchy",
      "items": [
        "16 local layers use 512-token sliding window and 10k standard RoPE",
        "4 global layers use full sequence attention and proportional 1M RoPE",
        "Multi-Query Attention (6 Q heads, 1 KV head) with explicit scale 1.0"
      ]
    },
    {
      "dot": "amber",
      "title": "Execution Separation",
      "items": [
        "Training uses chunked causal CE under checkpointing to avoid full logit tensors",
        "Inference uses request-local ProducerKVCache with local stream trimming to 512",
        "Tied vocabulary projection eliminates duplicate embedding parameter storage"
      ]
    }
  ]
