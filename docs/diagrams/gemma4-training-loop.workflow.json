    ],
    "requiredPaths": [
      {
        "from": "load_config",
        "to": "atomic_save"
      }
    ]
  },
  "nodes": [
    {
      "id": "load_config",
      "lane": "intake",
      "col": 0,
      "type": "frontend",
      "label": "Load Config",
      "sublabel": "configs/smoke.yaml",
      "width": 164
    },
    {
      "id": "init_model",
      "lane": "intake",
      "col": 1,
      "type": "backend",
      "label": "Init Model + AdamW",
      "sublabel": "seed 42 · decay matrices only",
      "width": 172
    },
    {
      "id": "stream_batches",
      "lane": "intake",
      "col": 2,
      "type": "external",
      "label": "Batch Stream",
      "sublabel": "synthetic / shard loader",
