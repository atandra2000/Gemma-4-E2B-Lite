      "width": 156
    },
    {
      "id": "fwd_bwd",
      "lane": "loop",
      "col": 3,
      "type": "backend",
      "label": "Forward + Backward",
      "sublabel": "chunked CE · sum-scaled",
      "width": 184
    },
    {
      "id": "finite_gate",
      "lane": "loop",
      "col": 4,
      "type": "security",
      "label": "Finite Gate",
      "sublabel": "loss + grads",
