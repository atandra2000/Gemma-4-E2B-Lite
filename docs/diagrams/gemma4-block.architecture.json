  "cards": [
    {
      "dot": "emerald",
      "title": "Repeated ×20",
      "items": [
        "Each of the 20 decoder blocks is an identical residual layer",
        "Block i consumes its own PLE slice [B,T,i,P] from the shared stack",
        "Post-norm output is added to the residual before the next sub-block"
      ]
    },
    {
      "dot": "cyan",
      "title": "Producer / Consumer Roles",
      "items": [
        "Prefix layers 0–9 compute and persist full-length K/V states",
        "Suffix layers 10–19 alias the last same-type producer's K/V",
        "Shared-suffix MLP intermediate width doubles to 6144"
      ]
    },
    {
      "dot": "amber",
      "title": "Numerics",
      "items": [
        "RMSNorm runs FP32 with a plain-multiplier scale weight",
        "Gated GELU-Tanh MLP replaces plain GELU activation",
        "The layer scalar is a unit buffer, not a trainable parameter"
      ]
    }
  ]
