  "cards": [
    {
      "dot": "emerald",
      "title": "One Pipeline, Five Consumers",
      "items": [
        "shared_data is the workspace library — projects never re-implement download, clean, or dedup",
        "Canonical mixture: fineweb-edu 0.40, dclm 0.15, stack-py 0.15, openmath 0.10, arxiv 0.10, jupyter 0.05, cosmopedia 0.05"
      ]
    },
    {
      "dot": "cyan",
      "title": "Resumable + Verified",
      "items": [
        "All five stages are idempotent and resumable via per-stage state files",
        "Shards are atomic, SHA-256-verified writes; manifest.json carries provenance and is validated before loading"
      ]
    },
    {
      "dot": "amber",
      "title": "Zero-Copy Consumption",
      "items": [
        "Windows are flat seq_len slices — the causal-CE shift happens in training/losses.py",
        "mmap reads never copy tokens; ShuffledRangeSampler is deterministic and resumable (seed 42)"
      ]
    }
  ]
